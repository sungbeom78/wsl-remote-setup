<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 기본 win-x64. ARM64 노트북용은 publish -r win-arm64 (ADR 0009) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>WslRemoteSetup</RootNamespace>
    <AssemblyName>WslRemoteSetup</AssemblyName>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 단일 EXE 배포 설정은 publish 시에만 적용 (DEVELOPMENT_PLAN 10절) -->
    <SelfContained>false</SelfContained>
    <!-- LibraryImport 소스 생성기(파이프 호출자 SID 확인 P/Invoke)에 필요 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WslRemoteSetup.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WSL 안에서 실행하는 고정 스크립트(단일 EXE에 포함). 사용자 입력은 인수 검증 후 전달하고 셸 코드에 이어 붙이지 않는다. -->
    <EmbeddedResource Include="..\..\resources\linux\*.sh" LogicalName="linux/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WslRemoteSetup.Core\WslRemoteSetup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
